   "source": [
    "import pandas as pd\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sklearn.svm import SVC\n",
    "from sklearn.preprocessing import LabelEncoder\n",
    "import pickle\n",
    "\n",
    "# 1. Load dataset\n",
    "data = pd.read_csv(\"UpdatedResumeDataSet.csv\")\n",
    "\n",
    "# 2. Separate features and target\n",
    "X = data['Resume']        # <-- Make sure this matches the column in your dataset\n",
    "y = data['Category']      # <-- Column containing the categories\n",
    "\n",
    "# 3. Encode target labels\n",
    "le = LabelEncoder()\n",
    "y_encoded = le.fit_transform(y)\n",
    "\n",
    "# 4. TF-IDF Vectorization\n",
    "tfidf = TfidfVectorizer(max_features=3000)  # You can adjust max_features\n",
    "X_tfidf = tfidf.fit_transform(X)\n",
    "\n",
    "# 5. Train SVC model\n",
    "svc_model = SVC(probability=True)\n",
    "svc_model.fit(X_tfidf, y_encoded)\n",
    "\n",
    "# 6. Save all pickle files\n",
    "with open('clf.pkl', 'wb') as f:\n",
    "    pickle.dump(svc_model, f)\n",
    "\n",
    "with open('tfidf.pkl', 'wb') as f:\n",
    "    pickle.dump(tfidf, f)\n",
    "\n",
    "with open('encoder.pkl', 'wb') as f:\n",
    "    pickle.dump(le, f)\n",
    "\n",
    "print(\"All files created successfully: clf.pkl, tfidf.pkl, encoder.pkl\")\n"
   ]
  },
